{
  "name": "dsh-desktop-client",
  "version": "0.1.3",
  "description": "DSH Desktop Client (DSHSD) — a Windows desktop client for DeepSeek Harness. Ships DSH itself: no Node.js, pnpm or npx required.",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "stage": "node tools/stage-vendor.js",
    "build": "npm run stage && electron-builder --config electron-builder.config.js --win nsis --publish never",
    "build:dir": "npm run stage && electron-builder --config electron-builder.config.js --win --dir --publish never",
    "verify:packaged": "node tools/verify-packaged.js",
    "verify:build": "node tools/verify-build.js",
    "verify:ui": "node tools/verify.js",
    "verify:lifecycle": "node tools/verify-lifecycle.js",
    "verify:config": "node tools/verify-config.js",
    "verify:theme": "node tools/verify-dsh-theme.js",
    "verify:matrix": "node tools/verify-matrix.js",
    "verify:quick": "node tools/verify-quick-ask.js",
    "icon": "node tools/run-electron.js tools/make-icon.js",
    "preview": "node tools/run-electron.js tools/preview-overlay.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  }
}
